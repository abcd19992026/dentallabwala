VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ⚠️ Do NOT add the Supabase Service Role key here (or to any VITE_-prefixed
# variable). Vite bundles every VITE_* variable into the public JS shipped to
# every visitor's browser, so a service role key placed here would give
# anyone full, unrestricted access to the entire database (bypassing all
# security rules) just by opening the browser's dev tools.
#
# The service role key must only ever live on the server side — it is
# already configured that way for the Supabase Edge Functions in
# supabase/functions/ (create-client, delete-client, deactivate-client),
# where it is set as a server secret, never as a VITE_ variable.
